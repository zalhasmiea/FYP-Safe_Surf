{
  "name": "Safe Surf",
  "description": "AI-Powered Phishing & Malware Scanner",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Safe Surf",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}